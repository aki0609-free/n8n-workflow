# cp env.example .env して値を設定してください（.env は Git 管理外）

# n8n イメージのタグ。チームで再現性を保つため具体的なバージョンに固定する
# （latest にすると破壊的変更を含む 3.x に上がる可能性がある。上げる前に n8n の breaking changes を確認すること）
N8N_VERSION=2.47.7
N8N_PORT=5678
GENERIC_TIMEZONE=Asia/Tokyo

# Credential の暗号化キー。一度決めたら変更しないこと（変更すると保存済み Credential が復号不能になる）
# 生成例: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Dashy（ワークフローのポータル）
DASHY_VERSION=4.9.0
DASHY_PORT=4000

# PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n-local-password
POSTGRES_DB=n8n
