[
  {
    "id": "credSlackBot0001",
    "name": "Slack Bot",
    "type": "slackApi",
    "data": { "accessToken": "${SLACK_BOT_TOKEN}" }
  },
  {
    "id": "credOpenAi000001",
    "name": "OpenAI",
    "type": "openAiApi",
    "data": { "apiKey": "${OPENAI_API_KEY}", "organizationId": "${OPENAI_ORGANIZATION_ID?}" }
  },
  {
    "id": "credAnthropic001",
    "name": "Anthropic",
    "type": "anthropicApi",
    "data": { "apiKey": "${ANTHROPIC_API_KEY}" }
  },
  {
    "id": "credNotion000001",
    "name": "Notion",
    "type": "notionApi",
    "data": { "apiKey": "${NOTION_API_KEY}" }
  },
  {
    "id": "credGitHub000001",
    "name": "GitHub",
    "type": "githubApi",
    "data": {
      "server": "https://api.github.com",
      "user": "${GITHUB_USER}",
      "accessToken": "${GITHUB_TOKEN}"
    }
  },
  {
    "id": "credGenericHdr01",
    "name": "Generic API (Header)",
    "type": "httpHeaderAuth",
    "data": { "name": "${GENERIC_API_HEADER_NAME}", "value": "${GENERIC_API_HEADER_VALUE}" }
  },
  {
    "id": "credSmtp00000001",
    "name": "SMTP",
    "type": "smtp",
    "data": {
      "host": "${SMTP_HOST}",
      "port": "${SMTP_PORT:number}",
      "user": "${SMTP_USER}",
      "password": "${SMTP_PASSWORD}",
      "secure": "${SMTP_SECURE:boolean}"
    }
  },
  {
    "id": "credExtPostgres1",
    "name": "External Postgres",
    "type": "postgres",
    "data": {
      "host": "${EXT_PG_HOST}",
      "port": "${EXT_PG_PORT:number}",
      "database": "${EXT_PG_DATABASE}",
      "user": "${EXT_PG_USER}",
      "password": "${EXT_PG_PASSWORD}"
    }
  }
]
