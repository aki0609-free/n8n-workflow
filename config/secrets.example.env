# =============================================================================
# 認証情報・API キーのひな形（このファイルはコミットされる。値は書かないこと）
#
#   npm run secrets:init   → secrets/secrets.env を作成（このファイルのコピー）
#   secrets/secrets.env に値を記入（secrets/ は .gitignore 済み）
#   npm run secrets:check  → 未入力のキーを確認（値は表示されない）
#   npm run n8n:credentials → n8n の Credential として一括登録
#
# 使い方は 2 種類:
#   [cred] … config/credentials.template.json で n8n の Credential に変換される。
#            ワークフローではノードの "credentials" に固定 ID で参照する（推奨）。
#   [env]  … n8n コンテナの環境変数として渡され、式で {{ $env.KEY }} として参照する。
#            チャンネル名・URL など「秘密ではない設定値」に使う。
#   ※ 本ファイルのキーはすべて n8n コンテナに環境変数として渡される（ローカル開発用の割り切り）。
#
# 新しいキーを追加したら `npm run secrets:init` を再実行すると、
# secrets/secrets.env に未記入の行として追記される（既存の値は変更されない）。
# =============================================================================

# ----- n8n Public API（テストデプロイ用） [script] ---------------------------
# n8n の UI > Settings > n8n API で発行。scripts/n8n-test-run.js が有効化・実行確認に使う
N8N_API_KEY=

# ----- Slack -----------------------------------------------------------------
# [cred] Slack App の Bot User OAuth Token（xoxb-...） → Credential "Slack Bot"
SLACK_BOT_TOKEN=
# [env] 既定の投稿先チャンネル（例: #general）
SLACK_DEFAULT_CHANNEL=
# [env] Incoming Webhook URL（HTTP Request ノードで直接 POST する場合）
SLACK_WEBHOOK_URL=

# ----- OpenAI ----------------------------------------------------------------
# [cred] → Credential "OpenAI"
OPENAI_API_KEY=
# [cred] 任意: Organization ID
OPENAI_ORGANIZATION_ID=

# ----- Anthropic (Claude) ----------------------------------------------------
# [cred] → Credential "Anthropic"
ANTHROPIC_API_KEY=

# ----- Notion ----------------------------------------------------------------
# [cred] Internal Integration Secret → Credential "Notion"
NOTION_API_KEY=

# ----- GitHub ----------------------------------------------------------------
# [cred] → Credential "GitHub"
GITHUB_USER=
GITHUB_TOKEN=

# ----- 汎用 API（HTTP Header Auth） -----------------------------------------
# [cred] 任意の REST API 用。例: NAME=Authorization / VALUE=Bearer xxxxx → Credential "Generic API (Header)"
GENERIC_API_HEADER_NAME=Authorization
GENERIC_API_HEADER_VALUE=
# [env] その API のベース URL
GENERIC_API_BASE_URL=

# ----- メール送信（SMTP） ----------------------------------------------------
# [cred] → Credential "SMTP"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# [env] 送信元アドレス
SMTP_FROM=

# ----- 外部 PostgreSQL（業務 DB など。n8n 自身の DB とは別） ---------------
# [cred] → Credential "External Postgres"
EXT_PG_HOST=
EXT_PG_PORT=5432
EXT_PG_DATABASE=
EXT_PG_USER=
EXT_PG_PASSWORD=

# ----- Discord ---------------------------------------------------------------
# [env] Webhook URL（HTTP Request ノードで POST）
DISCORD_WEBHOOK_URL=
